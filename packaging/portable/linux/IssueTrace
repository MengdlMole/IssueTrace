#!/bin/sh
set -eu
issuetrace_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export LD_LIBRARY_PATH="$issuetrace_root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$issuetrace_root/plugins"
export QML2_IMPORT_PATH="$issuetrace_root/qml"
exec "$issuetrace_root/bin/IssueTrace" "$@"
